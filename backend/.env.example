# =============================================================================
# PENTACLOUD BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# -----------------------------------------------------------------------------
# FRONTEND URL (for CORS and share links)
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# BACKBLAZE B2 ACCOUNTS (5 accounts = 50GB total free tier)
# -----------------------------------------------------------------------------
# Get these from: Backblaze B2 Console → App Keys → Create Application Key
# Each account needs: keyID, applicationKey, bucketId, bucketName
# Bucket Region: us-west-000, us-east-001, eu-central-003
# Max Size GB: 10 (free tier limit per account)

# Account 1
B2_1_NAME=Primary
B2_1_KEY_ID=your-key-id-1
B2_1_APPLICATION_KEY=your-application-key-1
B2_1_BUCKET_ID=your-bucket-id-1
B2_1_BUCKET_NAME=your-bucket-name-1
B2_1_BUCKET_REGION=us-west-000
B2_1_MAX_SIZE_GB=10

# Account 2
B2_2_NAME=Secondary
B2_2_KEY_ID=your-key-id-2
B2_2_APPLICATION_KEY=your-application-key-2
B2_2_BUCKET_ID=your-bucket-id-2
B2_2_BUCKET_NAME=your-bucket-name-2
B2_2_BUCKET_REGION=us-west-000
B2_2_MAX_SIZE_GB=10

# Account 3
B2_3_NAME=Tertiary
B2_3_KEY_ID=your-key-id-3
B2_3_APPLICATION_KEY=your-application-key-3
B2_3_BUCKET_ID=your-bucket-id-3
B2_3_BUCKET_NAME=your-bucket-name-3
B2_3_BUCKET_REGION=us-west-000
B2_3_MAX_SIZE_GB=10

# Account 4
B2_4_NAME=Quaternary
B2_4_KEY_ID=your-key-id-4
B2_4_APPLICATION_KEY=your-application-key-4
B2_4_BUCKET_ID=your-bucket-id-4
B2_4_BUCKET_NAME=your-bucket-name-4
B2_4_BUCKET_REGION=us-west-000
B2_4_MAX_SIZE_GB=10

# Account 5
B2_5_NAME=Quinary
B2_5_KEY_ID=your-key-id-5
B2_5_APPLICATION_KEY=your-application-key-5
B2_5_BUCKET_ID=your-bucket-id-5
B2_5_BUCKET_NAME=your-bucket-name-5
B2_5_BUCKET_REGION=us-west-000
B2_5_MAX_SIZE_GB=10

# -----------------------------------------------------------------------------
# OPTIONAL: FILE UPLOAD LIMITS
# -----------------------------------------------------------------------------
# MAX_FILE_SIZE_GB=5
# MAX_TOTAL_UPLOAD_SIZE_GB=50

# -----------------------------------------------------------------------------
# OPTIONAL: LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=info