# Frontend Production Environment Variables
# Copy this to .env.production and fill in the actual values

# API URL - Should point to the deployed Render backend
# Example: VITE_API_URL=https://pentacloud-api.onrender.com/api
VITE_API_URL=https://your-backend-url.onrender.com/api

# Optional: Feature flags
# VITE_ENABLE_SHARE_LINKS=true
# VITE_ENABLE_STORAGE_DASHBOARD=true
# VITE_ENABLE_FILE_PREVIEW=true

# Optional: Analytics/Monitoring
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx